<Window x:Class="DesktopDock.Views.EdgeTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-1000" Top="-1000" Width="7" Height="148"
        IsHitTestVisible="False" Focusable="False">

    <Border CornerRadius="0,4,4,0" Width="6" HorizontalAlignment="Left">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00E8C79B" Offset="0" />
                <GradientStop Color="#B3E8C79B" Offset="0.5" />
                <GradientStop Color="#00E8C79B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#E8C79B" Opacity="0.55" />
        </Border.Effect>
    </Border>
</Window>
